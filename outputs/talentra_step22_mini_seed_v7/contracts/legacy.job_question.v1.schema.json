{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:talentra:legacy.job_question.v1",
  "title": "legacy.job_question.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "correlation_id",
    "schema_version",
    "occurred_at",
    "source_version",
    "external_key",
    "job_requirement_id",
    "question_text",
    "answer_type_reference_value_id",
    "sort_order",
    "mandatory"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally unique producer event key within contract",
      "maxLength": 255
    },
    "correlation_id": {
      "type": "string",
      "description": "Safe trace correlation key",
      "maxLength": 255
    },
    "schema_version": {
      "type": "integer",
      "description": "Positive exact supported contract version",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "description": "UTC ISO8601 source timestamp",
      "maxLength": 255,
      "format": "date-time"
    },
    "source_version": {
      "type": "integer",
      "description": "Monotonic aggregate version",
      "minimum": 0
    },
    "external_key": {
      "type": "string",
      "description": "Stable opaque legacy entity key",
      "maxLength": 255
    },
    "job_requirement_id": {
      "type": "integer",
      "description": "64-bit surrogate identity; job requirement id on job_question",
      "minimum": 0
    },
    "question_text": {
      "type": "string",
      "description": "Bounded explanatory text; question text on job_question",
      "maxLength": 255
    },
    "answer_type_reference_value_id": {
      "type": "integer",
      "description": "64-bit surrogate identity; answer type reference value id on job_question",
      "minimum": 0
    },
    "sort_order": {
      "type": "integer",
      "description": "Integer quantity; sort order on job_question",
      "minimum": 0
    },
    "mandatory": {
      "type": "boolean",
      "description": "Explicit true/false flag; mandatory on job_question"
    }
  }
}