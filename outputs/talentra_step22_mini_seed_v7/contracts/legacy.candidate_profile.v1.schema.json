{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:talentra:legacy.candidate_profile.v1",
  "title": "legacy.candidate_profile.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "correlation_id",
    "schema_version",
    "occurred_at",
    "source_version",
    "external_key",
    "app_user_id",
    "status_reference_value_id",
    "content_language"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally unique producer event key within contract",
      "maxLength": 255
    },
    "correlation_id": {
      "type": "string",
      "description": "Safe trace correlation key",
      "maxLength": 255
    },
    "schema_version": {
      "type": "integer",
      "description": "Positive exact supported contract version",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "description": "UTC ISO8601 source timestamp",
      "maxLength": 255,
      "format": "date-time"
    },
    "source_version": {
      "type": "integer",
      "description": "Monotonic aggregate version",
      "minimum": 0
    },
    "external_key": {
      "type": "string",
      "description": "Stable opaque legacy entity key",
      "maxLength": 255
    },
    "app_user_id": {
      "type": "integer",
      "description": "64-bit surrogate identity; app user id on candidate_profile",
      "minimum": 0
    },
    "city_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "64-bit surrogate identity; city id on candidate_profile",
      "minimum": 0
    },
    "headline": {
      "type": [
        "string",
        "null"
      ],
      "description": "Bounded explanatory text; headline on candidate_profile",
      "maxLength": 20000
    },
    "birth_date": {
      "type": [
        "string",
        "null"
      ],
      "description": "Calendar date; birth date on candidate_profile",
      "maxLength": 255
    },
    "status_reference_value_id": {
      "type": "integer",
      "description": "64-bit surrogate identity; status reference value id on candidate_profile",
      "minimum": 0
    },
    "content_language": {
      "type": "string",
      "description": "Content/UI language code; content language on candidate_profile",
      "maxLength": 255
    }
  }
}