{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:talentra:legacy.job_question_option.v1",
  "title": "legacy.job_question_option.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "correlation_id",
    "schema_version",
    "occurred_at",
    "source_version",
    "external_key",
    "job_question_id",
    "code",
    "label_key",
    "sort_order",
    "active"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally unique producer event key within contract",
      "maxLength": 255
    },
    "correlation_id": {
      "type": "string",
      "description": "Safe trace correlation key",
      "maxLength": 255
    },
    "schema_version": {
      "type": "integer",
      "description": "Positive exact supported contract version",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "description": "UTC ISO8601 source timestamp",
      "maxLength": 255,
      "format": "date-time"
    },
    "source_version": {
      "type": "integer",
      "description": "Monotonic aggregate version",
      "minimum": 0
    },
    "external_key": {
      "type": "string",
      "description": "Stable opaque legacy entity key",
      "maxLength": 255
    },
    "job_question_id": {
      "type": "integer",
      "description": "Owning question",
      "minimum": 0
    },
    "code": {
      "type": "string",
      "description": "Stable option code within question",
      "maxLength": 255
    },
    "label_key": {
      "type": "string",
      "description": "UI translation key",
      "maxLength": 255
    },
    "sort_order": {
      "type": "integer",
      "description": "Option display order",
      "minimum": 0
    },
    "active": {
      "type": "boolean",
      "description": "Whether option can be selected"
    }
  }
}