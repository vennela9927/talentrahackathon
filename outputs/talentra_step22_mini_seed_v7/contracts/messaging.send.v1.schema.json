{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:talentra:messaging.send.v1",
  "title": "messaging.send.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "correlation_id",
    "schema_version",
    "occurred_at",
    "source_version",
    "notification_id",
    "recipient_token",
    "template_key",
    "expires_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally unique producer event key within contract",
      "maxLength": 255
    },
    "correlation_id": {
      "type": "string",
      "description": "Safe trace correlation key",
      "maxLength": 255
    },
    "schema_version": {
      "type": "integer",
      "description": "Positive exact supported contract version",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "description": "UTC ISO8601 source timestamp",
      "maxLength": 255,
      "format": "date-time"
    },
    "source_version": {
      "type": "integer",
      "description": "Monotonic aggregate version",
      "minimum": 0
    },
    "notification_id": {
      "type": "integer",
      "description": "Notification intent",
      "minimum": 0
    },
    "recipient_token": {
      "type": "string",
      "description": "Just-in-time permitted recipient token; never persisted in attempt logs",
      "maxLength": 255
    },
    "template_key": {
      "type": "string",
      "description": "Approved versioned message template",
      "maxLength": 255
    },
    "expires_at": {
      "type": "string",
      "description": "UTC intent expiry",
      "maxLength": 255
    }
  }
}