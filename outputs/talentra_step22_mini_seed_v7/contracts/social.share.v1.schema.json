{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:talentra:social.share.v1",
  "title": "social.share.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "correlation_id",
    "schema_version",
    "occurred_at",
    "source_version",
    "job_requirement_id",
    "channel_code",
    "shared_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally unique producer event key within contract",
      "maxLength": 255
    },
    "correlation_id": {
      "type": "string",
      "description": "Safe trace correlation key",
      "maxLength": 255
    },
    "schema_version": {
      "type": "integer",
      "description": "Positive exact supported contract version",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "description": "UTC ISO8601 source timestamp",
      "maxLength": 255,
      "format": "date-time"
    },
    "source_version": {
      "type": "integer",
      "description": "Monotonic aggregate version",
      "minimum": 0
    },
    "job_requirement_id": {
      "type": "integer",
      "description": "Published job correlation",
      "minimum": 0
    },
    "channel_code": {
      "type": "string",
      "description": "Approved network code",
      "maxLength": 255
    },
    "shared_at": {
      "type": "string",
      "description": "UTC outbound link activation time",
      "maxLength": 255
    }
  }
}