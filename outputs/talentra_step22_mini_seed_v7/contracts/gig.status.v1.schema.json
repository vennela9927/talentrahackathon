{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:talentra:gig.status.v1",
  "title": "gig.status.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "correlation_id",
    "schema_version",
    "occurred_at",
    "source_version",
    "assignment_id",
    "handoff_key",
    "status_code"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally unique producer event key within contract",
      "maxLength": 255
    },
    "correlation_id": {
      "type": "string",
      "description": "Safe trace correlation key",
      "maxLength": 255
    },
    "schema_version": {
      "type": "integer",
      "description": "Positive exact supported contract version",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "description": "UTC ISO8601 source timestamp",
      "maxLength": 255,
      "format": "date-time"
    },
    "source_version": {
      "type": "integer",
      "description": "Monotonic aggregate version",
      "minimum": 0
    },
    "assignment_id": {
      "type": "integer",
      "description": "Existing assignment",
      "minimum": 0
    },
    "handoff_key": {
      "type": "string",
      "description": "Provider accepted handoff reference",
      "maxLength": 255
    },
    "status_code": {
      "type": "string",
      "description": "External fulfilment state",
      "maxLength": 255
    }
  }
}