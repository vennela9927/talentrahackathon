{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:talentra:identity.request.v1",
  "title": "identity.request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "correlation_id",
    "schema_version",
    "occurred_at",
    "source_version",
    "candidate_profile_id",
    "consent_token"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally unique producer event key within contract",
      "maxLength": 255
    },
    "correlation_id": {
      "type": "string",
      "description": "Safe trace correlation key",
      "maxLength": 255
    },
    "schema_version": {
      "type": "integer",
      "description": "Positive exact supported contract version",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "description": "UTC ISO8601 source timestamp",
      "maxLength": 255,
      "format": "date-time"
    },
    "source_version": {
      "type": "integer",
      "description": "Monotonic aggregate version",
      "minimum": 0
    },
    "candidate_profile_id": {
      "type": "integer",
      "description": "Authenticated subject identifier",
      "minimum": 0
    },
    "consent_token": {
      "type": "string",
      "description": "Scoped consent receipt token; expire after request",
      "maxLength": 255
    }
  }
}