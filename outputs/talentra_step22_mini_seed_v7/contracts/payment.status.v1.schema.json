{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:talentra:payment.status.v1",
  "title": "payment.status.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "correlation_id",
    "schema_version",
    "occurred_at",
    "source_version",
    "payment_order_id",
    "provider_reference",
    "amount",
    "currency_code",
    "status_code"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally unique producer event key within contract",
      "maxLength": 255
    },
    "correlation_id": {
      "type": "string",
      "description": "Safe trace correlation key",
      "maxLength": 255
    },
    "schema_version": {
      "type": "integer",
      "description": "Positive exact supported contract version",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "description": "UTC ISO8601 source timestamp",
      "maxLength": 255,
      "format": "date-time"
    },
    "source_version": {
      "type": "integer",
      "description": "Monotonic aggregate version",
      "minimum": 0
    },
    "payment_order_id": {
      "type": "integer",
      "description": "Resolve previously issued local order",
      "minimum": 0
    },
    "provider_reference": {
      "type": "string",
      "description": "Opaque gateway settlement reference",
      "maxLength": 255
    },
    "amount": {
      "type": "string",
      "description": "Settled exact decimal amount",
      "maxLength": 19,
      "pattern": "^\\d{1,16}\\.\\d{2}$"
    },
    "currency_code": {
      "type": "string",
      "description": "Settlement currency",
      "maxLength": 3,
      "minLength": 3,
      "pattern": "^[A-Z]{3}$"
    },
    "status_code": {
      "type": "string",
      "description": "Gateway payment state",
      "maxLength": 255
    }
  }
}