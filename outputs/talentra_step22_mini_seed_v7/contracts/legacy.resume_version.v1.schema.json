{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:talentra:legacy.resume_version.v1",
  "title": "legacy.resume_version.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "correlation_id",
    "schema_version",
    "occurred_at",
    "source_version",
    "external_key",
    "candidate_profile_id",
    "version_number",
    "object_key",
    "content_hash",
    "content_language"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally unique producer event key within contract",
      "maxLength": 255
    },
    "correlation_id": {
      "type": "string",
      "description": "Safe trace correlation key",
      "maxLength": 255
    },
    "schema_version": {
      "type": "integer",
      "description": "Positive exact supported contract version",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "description": "UTC ISO8601 source timestamp",
      "maxLength": 255,
      "format": "date-time"
    },
    "source_version": {
      "type": "integer",
      "description": "Monotonic aggregate version",
      "minimum": 0
    },
    "external_key": {
      "type": "string",
      "description": "Stable opaque legacy entity key",
      "maxLength": 255
    },
    "candidate_profile_id": {
      "type": "integer",
      "description": "64-bit surrogate identity; candidate profile id on resume_version",
      "minimum": 0
    },
    "resume_template_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "64-bit surrogate identity; resume template id on resume_version",
      "minimum": 0
    },
    "version_number": {
      "type": "integer",
      "description": "Integer quantity; version number on resume_version",
      "minimum": 0
    },
    "object_key": {
      "type": "string",
      "description": "Private object-store reference; object key on resume_version",
      "maxLength": 255
    },
    "content_hash": {
      "type": "string",
      "description": "Opaque reference or cryptographic hash; content hash on resume_version",
      "maxLength": 255
    },
    "content_language": {
      "type": "string",
      "description": "Content/UI language code; content language on resume_version",
      "maxLength": 255
    }
  }
}