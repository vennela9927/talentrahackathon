{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:talentra:messaging.receipt.v1",
  "title": "messaging.receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "correlation_id",
    "schema_version",
    "occurred_at",
    "source_version",
    "notification_id",
    "provider_reference",
    "status_code",
    "attempted_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally unique producer event key within contract",
      "maxLength": 255
    },
    "correlation_id": {
      "type": "string",
      "description": "Safe trace correlation key",
      "maxLength": 255
    },
    "schema_version": {
      "type": "integer",
      "description": "Positive exact supported contract version",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "description": "UTC ISO8601 source timestamp",
      "maxLength": 255,
      "format": "date-time"
    },
    "source_version": {
      "type": "integer",
      "description": "Monotonic aggregate version",
      "minimum": 0
    },
    "notification_id": {
      "type": "integer",
      "description": "Issued notification",
      "minimum": 0
    },
    "provider_reference": {
      "type": "string",
      "description": "Delivery receipt reference",
      "maxLength": 255
    },
    "status_code": {
      "type": "string",
      "description": "Provider delivery state",
      "maxLength": 255
    },
    "attempted_at": {
      "type": "string",
      "description": "UTC provider attempt timestamp",
      "maxLength": 255
    }
  }
}