{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:talentra:gig.earnings.v1",
  "title": "gig.earnings.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "correlation_id",
    "schema_version",
    "occurred_at",
    "source_version",
    "assignment_id",
    "provider_reference",
    "estimated_amount",
    "total_amount",
    "projected_amount",
    "currency_code",
    "reconciled_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally unique producer event key within contract",
      "maxLength": 255
    },
    "correlation_id": {
      "type": "string",
      "description": "Safe trace correlation key",
      "maxLength": 255
    },
    "schema_version": {
      "type": "integer",
      "description": "Positive exact supported contract version",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "description": "UTC ISO8601 source timestamp",
      "maxLength": 255,
      "format": "date-time"
    },
    "source_version": {
      "type": "integer",
      "description": "Monotonic aggregate version",
      "minimum": 0
    },
    "assignment_id": {
      "type": "integer",
      "description": "Existing assignment",
      "minimum": 0
    },
    "provider_reference": {
      "type": "string",
      "description": "Earnings statement reference",
      "maxLength": 255
    },
    "estimated_amount": {
      "type": "string",
      "description": "Provider-owned reconciled monetary amount",
      "maxLength": 19,
      "pattern": "^\\d{1,16}\\.\\d{2}$"
    },
    "total_amount": {
      "type": "string",
      "description": "Provider-owned reconciled monetary amount",
      "maxLength": 19,
      "pattern": "^\\d{1,16}\\.\\d{2}$"
    },
    "projected_amount": {
      "type": "string",
      "description": "Provider-owned reconciled monetary amount",
      "maxLength": 19,
      "pattern": "^\\d{1,16}\\.\\d{2}$"
    },
    "currency_code": {
      "type": "string",
      "description": "Earnings currency",
      "maxLength": 3,
      "minLength": 3,
      "pattern": "^[A-Z]{3}$"
    },
    "reconciled_at": {
      "type": "string",
      "description": "UTC statement reconciliation time",
      "maxLength": 255,
      "format": "date-time"
    }
  }
}