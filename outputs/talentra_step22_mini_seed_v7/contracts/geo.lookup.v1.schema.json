{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:talentra:geo.lookup.v1",
  "title": "geo.lookup.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "correlation_id",
    "schema_version",
    "occurred_at",
    "source_version",
    "city_id",
    "place_query"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally unique producer event key within contract",
      "maxLength": 255
    },
    "correlation_id": {
      "type": "string",
      "description": "Safe trace correlation key",
      "maxLength": 255
    },
    "schema_version": {
      "type": "integer",
      "description": "Positive exact supported contract version",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "description": "UTC ISO8601 source timestamp",
      "maxLength": 255,
      "format": "date-time"
    },
    "source_version": {
      "type": "integer",
      "description": "Monotonic aggregate version",
      "minimum": 0
    },
    "city_id": {
      "type": "integer",
      "description": "Place correlation",
      "minimum": 0
    },
    "place_query": {
      "type": "string",
      "description": "Country-qualified city label; no precise personal location",
      "maxLength": 255
    }
  }
}