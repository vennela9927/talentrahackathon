{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:talentra:reference.insights.v1",
  "title": "reference.insights.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "correlation_id",
    "schema_version",
    "occurred_at",
    "source_version",
    "source_reference",
    "refresh_at",
    "insight_kind"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Globally unique producer event key within contract",
      "maxLength": 255
    },
    "correlation_id": {
      "type": "string",
      "description": "Safe trace correlation key",
      "maxLength": 255
    },
    "schema_version": {
      "type": "integer",
      "description": "Positive exact supported contract version",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "description": "UTC ISO8601 source timestamp",
      "maxLength": 255,
      "format": "date-time"
    },
    "source_version": {
      "type": "integer",
      "description": "Monotonic aggregate version",
      "minimum": 0
    },
    "source_reference": {
      "type": "string",
      "description": "Approved attribution URL; optional Tier3 data held outside transactional core",
      "maxLength": 255
    },
    "refresh_at": {
      "type": "string",
      "description": "UTC refresh instant; stale value must be visibly marked",
      "maxLength": 255
    },
    "insight_kind": {
      "type": "string",
      "description": "salary_benchmark or company_review; do not collect review author PII",
      "maxLength": 255
    }
  }
}